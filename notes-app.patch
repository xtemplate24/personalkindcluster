+++ b/apps/notes/frontend/src/App.css
@@ -0,0 +1,226 @@
+/* Colours, glass recipe and the aurora background live in index.css (:root). */
+
+.page { max-width: 760px; margin: 0 auto; padding: clamp(20px, 5vw, 56px) 16px 72px; }
+
+h1, h2 { font-family: "Space Grotesk", sans-serif; }
+h1 { font-size: clamp(1.7rem, 4vw, 2.2rem); font-weight: 600; margin: 0 0 4px; color: var(--text-strong); letter-spacing: -0.01em; }
+h2 { display: flex; align-items: center; gap: 8px; font-size: 1.05rem; font-weight: 500; margin: 32px 0 12px; color: var(--text-soft); }
+.muted { color: var(--muted); }
+.small { font-size: 0.85rem; }
+.mono { font-family: "IBM Plex Mono", monospace; }
+.center { text-align: center; }
+.error { color: var(--danger); }
+p { margin: 0; }
+
+/* ---------- motion ---------- */
+@keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
+@keyframes pop { 0% { opacity: 0; transform: scale(0.85); } 100% { opacity: 1; transform: scale(1); } }
+@keyframes spin { to { transform: rotate(360deg); } }
+@keyframes shimmer { from { background-position: 0 0; } to { background-position: 40px 0; } }
+
+.screen { animation: fadeUp 0.35s ease-out both; }
+.pop { animation: pop 0.25s ease-out both; }
+.spinner { width: 34px; height: 34px; margin: 80px auto; border: 3px solid rgba(var(--white-rgb), 0.12); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.8s linear infinite; }
+
+/* ---------- glass surfaces ---------- */
+.glass, .note-card {
+  background: var(--glass-bg);
+  border: var(--glass-border);
+  border-radius: var(--panel-radius);
+  box-shadow: var(--glass-shadow);
+  -webkit-backdrop-filter: var(--glass-blur);
+  backdrop-filter: var(--glass-blur);
+}
+
+/* ---------- buttons: glass pills (same as app3) ---------- */
+button, input, textarea { font-family: inherit; }
+
+button, .icon-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  font-size: 0.95rem;
+  padding: 10px 18px;
+  color: var(--text);
+  background: var(--glass-bg);
+  border: var(--glass-border);
+  border-radius: var(--btn-radius);
+  box-shadow: var(--glass-shadow);
+  -webkit-backdrop-filter: var(--glass-blur);
+  backdrop-filter: var(--glass-blur);
+  cursor: pointer;
+  text-decoration: none;
+  transition: transform 0.15s, border-color 0.2s, box-shadow 0.2s, background 0.2s, color 0.2s, opacity 0.2s;
+}
+button:hover:not(:disabled), .icon-btn:hover { transform: translateY(-2px); background: var(--glass-bg-hover); border-color: var(--glass-border-hover); }
+button:active:not(:disabled), .icon-btn:active { transform: scale(0.97); }
+button:disabled { opacity: 0.4; cursor: default; }
+button:focus-visible, .icon-btn:focus-visible, a:focus-visible, .drop:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
+
+button.primary {
+  background: var(--accent-grad);
+  color: var(--on-accent);
+  border: 1px solid rgba(var(--white-rgb), 0.35);
+  font-weight: 600;
+  font-family: "Space Grotesk", sans-serif;
+  box-shadow: inset 0 1px 0 rgba(var(--white-rgb), 0.5), 0 8px 24px rgba(var(--accent-rgb), 0.25);
+}
+button.primary:hover:not(:disabled) {
+  background: var(--accent-grad-hover);
+  box-shadow: inset 0 1px 0 rgba(var(--white-rgb), 0.5), 0 10px 28px rgba(var(--accent-rgb), 0.4);
+}
+
+button.danger { background: var(--danger-solid); color: var(--on-danger); border-color: rgba(var(--white-rgb), 0.25); }
+button.danger:hover:not(:disabled) { background: var(--danger-solid-hover); }
+
+/* text-only buttons */
+button.ghost {
+  background: none; border-color: transparent; box-shadow: none;
+  -webkit-backdrop-filter: none; backdrop-filter: none;
+  color: var(--muted); padding: 8px 12px;
+}
+button.ghost:hover:not(:disabled) { color: var(--text); background: rgba(var(--white-rgb), 0.06); border-color: transparent; transform: none; }
+button.ghost.danger-text:hover:not(:disabled) { color: var(--danger); }
+button.back { margin-left: -12px; }
+
+.icon-btn { width: 36px; height: 36px; padding: 0; border-radius: 50%; color: var(--text-soft); }
+.small-btn { padding: 6px 12px; font-size: 0.85rem; }
+
+/* ---------- inputs ---------- */
+input {
+  flex: 1;
+  min-width: 0;
+  padding: 12px 16px;
+  font-size: 1rem;
+  color: var(--text);
+  background: rgba(var(--white-rgb), 0.05);
+  border: var(--glass-border);
+  border-radius: var(--field-radius);
+  box-shadow: inset 0 2px 6px rgba(var(--black-rgb), 0.3);
+  transition: border-color 0.2s, box-shadow 0.2s;
+}
+input:focus { outline: none; border-color: var(--accent); box-shadow: inset 0 2px 6px rgba(var(--black-rgb), 0.3), 0 0 0 3px rgba(var(--accent-rgb), 0.2); }
+input::placeholder, textarea::placeholder { color: var(--muted); opacity: 0.8; }
+
+/* ---------- list screen ---------- */
+.top { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; }
+
+.usage { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
+.usage .track { flex: 1; }
+.track { background: rgba(var(--white-rgb), 0.08); border-radius: 999px; height: 8px; overflow: hidden; box-shadow: inset 0 1px 3px rgba(var(--black-rgb), 0.4); }
+.fill { height: 100%; border-radius: 999px; background: var(--accent-grad); transition: width 0.3s ease; }
+.fill.live {
+  background-image: repeating-linear-gradient(-45deg, rgba(var(--white-rgb), 0.25) 0 10px, transparent 10px 20px), var(--accent-grad);
+  background-size: 40px 100%, 100% 100%;
+  animation: shimmer 0.8s linear infinite;
+}
+
+.search { position: relative; display: flex; align-items: center; color: var(--muted); }
+.search svg { position: absolute; left: 16px; pointer-events: none; }
+.search input { padding-left: 44px; }
+
+.list { list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 10px; }
+.list li { animation: fadeUp 0.4s ease-out both; animation-delay: calc(var(--i, 0) * 40ms); }
+
+.note-card {
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  gap: 6px;
+  padding: 16px 20px;
+  text-align: left;
+}
+.note-card:hover:not(:disabled) { border-color: var(--glass-border-hover); }
+.note-title { font-family: "Space Grotesk", sans-serif; font-size: 1.1rem; font-weight: 500; color: var(--text-strong); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.note-preview {
+  color: var(--text-soft); font-size: 0.9rem; line-height: 1.45;
+  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
+}
+.note-meta { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 0.8rem; font-family: "IBM Plex Mono", monospace; }
+.pill { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px; background: rgba(var(--accent-rgb), 0.12); color: var(--accent); }
+
+.empty { text-align: center; padding: 40px 20px; margin-top: 16px; display: grid; gap: 6px; }
+
+/* ---------- editor ---------- */
+.editor-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
+.save-state { font-family: "IBM Plex Mono", monospace; font-size: 0.8rem; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; }
+.save-state::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 8px var(--teal); }
+.save-state.dirty::before, .save-state.saving::before { background: var(--amber); box-shadow: 0 0 8px var(--amber); }
+.save-state.error { color: var(--danger); }
+.save-state.error::before { background: var(--danger); box-shadow: 0 0 8px var(--danger); }
+
+.sheet { padding: 22px clamp(18px, 4vw, 30px) 26px; }
+.title-input, .body-input {
+  width: 100%;
+  background: none;
+  border: 0;
+  box-shadow: none;
+  padding: 0;
+  color: var(--text);
+  border-radius: 0;
+}
+.title-input { font-family: "Space Grotesk", sans-serif; font-size: clamp(1.4rem, 3.5vw, 1.8rem); font-weight: 600; color: var(--text-strong); margin-bottom: 14px; }
+.title-input:focus { box-shadow: none; }
+.body-input {
+  display: block;
+  min-height: 40vh;
+  resize: none;
+  overflow: hidden;
+  font-size: 1rem;
+  line-height: 1.65;
+}
+.body-input:focus { outline: none; }
+
+/* ---------- attachments ---------- */
+.drop {
+  display: grid;
+  justify-items: center;
+  gap: 4px;
+  padding: 22px 16px;
+  text-align: center;
+  color: var(--text-soft);
+  border: 1.5px dashed rgba(var(--white-rgb), 0.22);
+  border-radius: var(--panel-radius);
+  background: rgba(var(--white-rgb), 0.03);
+  cursor: pointer;
+  transition: border-color 0.2s, background 0.2s, color 0.2s;
+}
+.drop:hover { border-color: rgba(var(--white-rgb), 0.35); color: var(--text); }
+.drop.over { border-color: var(--accent); background: rgba(var(--accent-rgb), 0.08); color: var(--accent); }
+.drop svg { color: var(--accent); margin-bottom: 4px; }
+
+.uploads { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 8px; }
+.uploads li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(80px, 1.2fr) auto; align-items: center; gap: 12px; font-size: 0.9rem; }
+.uploads li.failed { grid-template-columns: minmax(0, 1fr) auto auto; }
+.up-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+.files { list-style: none; padding: 0; margin: 14px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
+.file { display: flex; flex-direction: column; overflow: hidden; animation: fadeUp 0.4s ease-out both; animation-delay: calc(var(--i, 0) * 40ms); }
+.thumb {
+  display: grid;
+  place-items: center;
+  aspect-ratio: 16 / 10;
+  background: rgba(var(--black-rgb), 0.25);
+  border-bottom: 1px solid rgba(var(--white-rgb), 0.08);
+  overflow: hidden;
+  text-decoration: none;
+}
+.thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s; }
+.thumb:hover img { transform: scale(1.04); }
+.ext { font-family: "IBM Plex Mono", monospace; font-size: 1.1rem; font-weight: 500; color: var(--accent); letter-spacing: 0.06em; padding: 10px 14px; border: 1px solid rgba(var(--accent-rgb), 0.35); border-radius: 12px; background: rgba(var(--accent-rgb), 0.06); }
+.file-info { display: grid; gap: 2px; padding: 10px 14px 4px; min-width: 0; }
+.file-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 0.92rem; }
+.file-actions { display: flex; gap: 8px; padding: 6px 14px 12px; justify-content: flex-end; }
+
+/* ---------- footer ---------- */
+.note-footer { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-top: 36px; padding-top: 18px; border-top: 1px solid rgba(var(--white-rgb), 0.08); }
+.confirm { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 0.9rem; }
+
+@media (max-width: 480px) {
+  .top button.primary { width: 100%; }
+  .files { grid-template-columns: 1fr 1fr; gap: 10px; }
+  .file-actions { padding: 4px 10px 10px; }
+  .file-info { padding: 8px 10px 2px; }
+}
diff --git a/apps/notes/frontend/src/App.jsx b/apps/notes/frontend/src/App.jsx
new file mode 100644
index 0000000..36c4d89
--- /dev/null
+++ b/apps/notes/frontend/src/App.jsx
@@ -0,0 +1,488 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import "./App.css";
+
+const API = `${import.meta.env.BASE_URL}api`;
+const SAVE_DELAY = 700; // ms of no typing before a note autosaves
+
+// ---------- API helpers ----------
+async function call(path, { method, body } = {}) {
+  const res = await fetch(`${API}${path}`, {
+    method: method || (body ? "POST" : "GET"),
+    headers: body ? { "Content-Type": "application/json" } : undefined,
+    body: body ? JSON.stringify(body) : undefined,
+  });
+  // If the login cookie expired, oauth2-proxy answers with its sign-in page (HTML).
+  const isJson = (res.headers.get("content-type") || "").includes("application/json");
+  if (!isJson) throw new Error("You've been signed out. Reload the page to sign in again.");
+  const data = await res.json();
+  if (!res.ok) throw new Error(data.error || `Error ${res.status}`);
+  return data;
+}
+
+// fetch() can't report upload progress, XMLHttpRequest can.
+function uploadFile(noteId, file, onProgress) {
+  return new Promise((resolve, reject) => {
+    const xhr = new XMLHttpRequest();
+    xhr.open("POST", `${API}/notes/${noteId}/files`);
+    xhr.setRequestHeader("X-File-Name", encodeURIComponent(file.name));
+    xhr.setRequestHeader("Content-Type", file.type || "application/octet-stream");
+    xhr.upload.onprogress = (e) => e.lengthComputable && onProgress(e.loaded / e.total);
+    xhr.onload = () => {
+      let data = {};
+      try { data = JSON.parse(xhr.responseText); } catch { /* not JSON */ }
+      if (xhr.status >= 200 && xhr.status < 300) resolve(data);
+      else reject(new Error(data.error || `Upload failed (${xhr.status})`));
+    };
+    xhr.onerror = () => reject(new Error("Network error during upload"));
+    xhr.send(file);
+  });
+}
+
+// ---------- formatting ----------
+const fmtSize = (b) =>
+  b < 1024 ? `${b} B` : b < 1024 ** 2 ? `${(b / 1024).toFixed(0)} KB` : b < 1024 ** 3 ? `${(b / 1024 ** 2).toFixed(1)} MB` : `${(b / 1024 ** 3).toFixed(2)} GB`;
+
+const fmtDate = (iso) => {
+  const d = new Date(iso);
+  const today = new Date();
+  if (d.toDateString() === today.toDateString())
+    return d.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
+  return d.toLocaleDateString([], { day: "numeric", month: "short", ...(d.getFullYear() !== today.getFullYear() && { year: "numeric" }) });
+};
+
+const ext = (name) => (name.includes(".") ? name.split(".").pop().slice(0, 4).toUpperCase() : "FILE");
+const isImage = (type) => /^image\/(png|jpeg|gif|webp|avif)$/.test(type);
+
+// ---------- tiny icon set (stroke icons, inherit colour) ----------
+const PATHS = {
+  plus: "M12 5v14M5 12h14",
+  back: "M15 18l-6-6 6-6",
+  clip: "M21 11.5l-8.6 8.6a5 5 0 01-7.1-7.1l8.6-8.6a3.3 3.3 0 014.7 4.7l-8.6 8.6a1.7 1.7 0 01-2.4-2.4l8-8",
+  down: "M12 4v12m0 0l-5-5m5 5l5-5M5 20h14",
+  trash: "M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3",
+  search: "M11 18a7 7 0 100-14 7 7 0 000 14zM21 21l-5-5",
+  upload: "M12 16V4m0 0L7 9m5-5l5 5M5 20h14",
+  x: "M6 6l12 12M18 6L6 18",
+};
+const Icon = ({ name, size = 18 }) => (
+  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
+    strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+    <path d={PATHS[name]} />
+  </svg>
+);
+
+// The open note lives in the URL hash (#/n/<id>) so the browser back button works.
+const readHash = () => (window.location.hash.match(/^#\/n\/([0-9a-f-]{36})$/) || [])[1] || null;
+
+// =====================================================================
+export default function App() {
+  const [openId, setOpenId] = useState(readHash);
+  const [usage, setUsage] = useState(null);
+
+  useEffect(() => {
+    const onHash = () => setOpenId(readHash());
+    window.addEventListener("hashchange", onHash);
+    return () => window.removeEventListener("hashchange", onHash);
+  }, []);
+
+  const refreshUsage = useCallback(() => call("/usage").then(setUsage).catch(() => {}), []);
+  useEffect(() => { refreshUsage(); }, [refreshUsage]);
+
+  const open = (id) => { window.location.hash = id ? `/n/${id}` : ""; };
+
+  return (
+    <div className="page">
+      {openId ? (
+        <Editor key={openId} id={openId} usage={usage} onClose={() => open(null)} onUsage={refreshUsage} />
+      ) : (
+        <NoteList usage={usage} onOpen={open} />
+      )}
+    </div>
+  );
+}
+
+// =====================================================================
+function NoteList({ usage, onOpen }) {
+  const [notes, setNotes] = useState(null);
+  const [error, setError] = useState("");
+  const [search, setSearch] = useState("");
+  const [creating, setCreating] = useState(false);
+
+  useEffect(() => {
+    call("/notes").then(setNotes).catch((e) => setError(e.message));
+  }, []);
+
+  const shown = useMemo(() => {
+    if (!notes) return [];
+    const s = search.trim().toLowerCase();
+    return s ? notes.filter((n) => `${n.title} ${n.preview}`.toLowerCase().includes(s)) : notes;
+  }, [notes, search]);
+
+  const create = async () => {
+    setCreating(true);
+    try {
+      const n = await call("/notes", { body: { title: "", body: "" } });
+      onOpen(n.id);
+    } catch (e) {
+      setError(e.message);
+      setCreating(false);
+    }
+  };
+
+  return (
+    <div className="screen">
+      <header className="top">
+        <div>
+          <h1>Notes</h1>
+          <p className="muted small">Your notes and files, stored on the home lab.</p>
+        </div>
+        <button className="primary" onClick={create} disabled={creating}>
+          <Icon name="plus" /> New note
+        </button>
+      </header>
+
+      {usage && <UsageBar usage={usage} />}
+
+      <label className="search">
+        <Icon name="search" />
+        <input
+          type="search"
+          placeholder="Search notes"
+          value={search}
+          onChange={(e) => setSearch(e.target.value)}
+          aria-label="Search notes"
+        />
+      </label>
+
+      {error && <p className="error">{error}</p>}
+      {!notes && !error && <div className="spinner" />}
+
+      {notes && notes.length === 0 && (
+        <div className="empty glass">
+          <p>No notes yet.</p>
+          <p className="muted small">Create one, then drop files onto it to attach them.</p>
+        </div>
+      )}
+      {notes && notes.length > 0 && shown.length === 0 && <p className="muted center">Nothing matches “{search}”.</p>}
+
+      <ul className="list">
+        {shown.map((n, i) => (
+          <li key={n.id} style={{ "--i": Math.min(i, 12) }}>
+            <button className="note-card" onClick={() => onOpen(n.id)}>
+              <span className="note-title">{n.title || "Untitled"}</span>
+              {n.preview.trim() && <span className="note-preview">{n.preview.replace(/\s+/g, " ").trim()}</span>}
+              <span className="note-meta">
+                <span>{fmtDate(n.updated)}</span>
+                {n.files > 0 && (
+                  <span className="pill"><Icon name="clip" size={13} /> {n.files}</span>
+                )}
+              </span>
+            </button>
+          </li>
+        ))}
+      </ul>
+    </div>
+  );
+}
+
+function UsageBar({ usage }) {
+  const pct = Math.min(100, (usage.used / usage.quota) * 100);
+  return (
+    <div className="usage" title={`${fmtSize(usage.used)} of ${fmtSize(usage.quota)} used`}>
+      <div className="track"><div className="fill" style={{ width: `${pct}%` }} /></div>
+      <span className="mono small muted">{fmtSize(usage.used)} / {fmtSize(usage.quota)}</span>
+    </div>
+  );
+}
+
+// =====================================================================
+function Editor({ id, usage, onClose, onUsage }) {
+  const [note, setNote] = useState(null);
+  const [error, setError] = useState("");
+  const [status, setStatus] = useState("saved"); // saved | dirty | saving | error
+  const [confirmDelete, setConfirmDelete] = useState(false);
+
+  const draft = useRef(null);  // latest title/body, read by the save timer
+  const timer = useRef(null);
+  const bodyRef = useRef(null);
+
+  useEffect(() => {
+    call(`/notes/${id}`)
+      .then((n) => { setNote(n); draft.current = { title: n.title, body: n.body }; })
+      .catch((e) => setError(e.message));
+    return () => clearTimeout(timer.current);
+  }, [id]);
+
+  // grow the textarea with its content
+  useEffect(() => {
+    const el = bodyRef.current;
+    if (el) { el.style.height = "auto"; el.style.height = `${el.scrollHeight}px`; }
+  }, [note?.body]);
+
+  const save = useCallback(async () => {
+    clearTimeout(timer.current);
+    if (!draft.current) return;
+    setStatus("saving");
+    try {
+      await call(`/notes/${id}`, { method: "PUT", body: draft.current });
+      setStatus("saved");
+    } catch (e) {
+      setStatus("error");
+      setError(e.message);
+    }
+  }, [id]);
+
+  const edit = (field) => (e) => {
+    const value = e.target.value;
+    setNote((n) => ({ ...n, [field]: value }));
+    draft.current = { ...draft.current, [field]: value };
+    setStatus("dirty");
+    clearTimeout(timer.current);
+    timer.current = setTimeout(save, SAVE_DELAY);
+  };
+
+  // Leaving: save pending changes; quietly drop a note that was never used.
+  const close = async () => {
+    if (note && !note.title.trim() && !note.body.trim() && note.files.length === 0) {
+      await call(`/notes/${id}`, { method: "DELETE" }).catch(() => {});
+    } else if (status === "dirty") {
+      await save();
+    }
+    onClose();
+  };
+
+  // Save before the tab closes or reloads.
+  useEffect(() => {
+    const onLeave = () => {
+      if (status === "dirty" && draft.current) {
+        fetch(`${API}/notes/${id}`, {
+          method: "PUT", keepalive: true,
+          headers: { "Content-Type": "application/json" },
+          body: JSON.stringify(draft.current),
+        });
+      }
+    };
+    window.addEventListener("pagehide", onLeave);
+    return () => window.removeEventListener("pagehide", onLeave);
+  }, [id, status]);
+
+  const removeNote = async () => {
+    try {
+      await call(`/notes/${id}`, { method: "DELETE" });
+      onUsage();
+      onClose();
+    } catch (e) {
+      setError(e.message);
+    }
+  };
+
+  const setFiles = (fn) => setNote((n) => ({ ...n, files: fn(n.files) }));
+
+  if (!note) {
+    return (
+      <div className="screen">
+        <button className="ghost back" onClick={onClose}><Icon name="back" /> All notes</button>
+        {error ? <p className="error">{error}</p> : <div className="spinner" />}
+      </div>
+    );
+  }
+
+  return (
+    <div className="screen">
+      <div className="editor-bar">
+        <button className="ghost back" onClick={close}><Icon name="back" /> All notes</button>
+        <span className={`save-state ${status}`} aria-live="polite">
+          {{ saved: "Saved", dirty: "Editing…", saving: "Saving…", error: "Not saved" }[status]}
+        </span>
+      </div>
+
+      <div className="sheet glass">
+        <input
+          className="title-input"
+          placeholder="Title"
+          value={note.title}
+          onChange={edit("title")}
+          maxLength={200}
+          aria-label="Title"
+        />
+        <textarea
+          ref={bodyRef}
+          className="body-input"
+          placeholder="Start writing…"
+          value={note.body}
+          onChange={edit("body")}
+          aria-label="Note"
+        />
+      </div>
+
+      {error && <p className="error">{error}</p>}
+
+      <Attachments
+        noteId={id}
+        files={note.files}
+        setFiles={setFiles}
+        maxFile={usage?.maxFile ?? 50 * 1024 * 1024}
+        onUsage={onUsage}
+      />
+
+      <div className="note-footer">
+        <span className="muted small">Edited {fmtDate(note.updated)}</span>
+        {!confirmDelete ? (
+          <button className="ghost danger-text" onClick={() => setConfirmDelete(true)}>
+            <Icon name="trash" /> Delete note
+          </button>
+        ) : (
+          <div className="confirm pop">
+            <span>Delete this note{note.files.length ? ` and ${note.files.length} file${note.files.length > 1 ? "s" : ""}` : ""}?</span>
+            <button onClick={() => setConfirmDelete(false)}>Cancel</button>
+            <button className="danger" onClick={removeNote}>Delete</button>
+          </div>
+        )}
+      </div>
+    </div>
+  );
+}
+
+// =====================================================================
+function Attachments({ noteId, files, setFiles, maxFile, onUsage }) {
+  const [queue, setQueue] = useState([]); // uploads in progress: {key, name, progress, error}
+  const [dragging, setDragging] = useState(false);
+  const [confirmId, setConfirmId] = useState(null);
+  const input = useRef(null);
+  const busy = useRef(false);    // is the upload loop running?
+  const pending = useRef([]);    // files waiting their turn
+
+  const patch = (key, changes) => setQueue((q) => q.map((u) => (u.key === key ? { ...u, ...changes } : u)));
+
+  // Uploads run one at a time, so the backend never holds several big files at once.
+  const addFiles = async (list) => {
+    const items = [...list].map((file) => ({
+      key: `${file.name}-${file.size}-${Math.random()}`,
+      file, name: file.name, progress: 0,
+      error: file.size > maxFile ? `Over the ${fmtSize(maxFile)} limit` : file.size === 0 ? "Empty file" : "",
+    }));
+    setQueue((q) => [...q, ...items]);
+    if (busy.current) { pending.current.push(...items); return; }
+    busy.current = true;
+    pending.current.push(...items);
+    while (pending.current.length) {
+      const u = pending.current.shift();
+      if (u.error) continue;
+      try {
+        const saved = await uploadFile(noteId, u.file, (p) => patch(u.key, { progress: p }));
+        setFiles((f) => [...f, saved]);
+        setQueue((q) => q.filter((x) => x.key !== u.key));
+        onUsage();
+      } catch (e) {
+        patch(u.key, { error: e.message });
+      }
+    }
+    busy.current = false;
+  };
+
+  // paste a screenshot anywhere on the page to attach it
+  useEffect(() => {
+    const onPaste = (e) => {
+      const pasted = [...(e.clipboardData?.files || [])];
+      if (pasted.length) { e.preventDefault(); addFiles(pasted); }
+    };
+    window.addEventListener("paste", onPaste);
+    return () => window.removeEventListener("paste", onPaste);
+  });
+
+  const remove = async (id) => {
+    setConfirmId(null);
+    try {
+      await call(`/files/${id}`, { method: "DELETE" });
+      setFiles((f) => f.filter((x) => x.id !== id));
+      onUsage();
+    } catch (e) {
+      alert(e.message);
+    }
+  };
+
+  return (
+    <section className="attachments">
+      <h2><Icon name="clip" size={16} /> Attachments {files.length > 0 && <span className="muted">· {files.length}</span>}</h2>
+
+      <div
+        className={`drop ${dragging ? "over" : ""}`}
+        role="button"
+        tabIndex={0}
+        onClick={() => input.current.click()}
+        onKeyDown={(e) => (e.key === "Enter" || e.key === " ") && input.current.click()}
+        onDragOver={(e) => { e.preventDefault(); setDragging(true); }}
+        onDragLeave={() => setDragging(false)}
+        onDrop={(e) => { e.preventDefault(); setDragging(false); addFiles(e.dataTransfer.files); }}
+      >
+        <Icon name="upload" size={22} />
+        <span>Drop files here, paste, or <u>browse</u></span>
+        <span className="muted small">Up to {fmtSize(maxFile)} each</span>
+        <input
+          ref={input}
+          type="file"
+          multiple
+          hidden
+          onChange={(e) => { addFiles(e.target.files); e.target.value = ""; }}
+        />
+      </div>
+
+      {queue.length > 0 && (
+        <ul className="uploads">
+          {queue.map((u) => (
+            <li key={u.key} className={u.error ? "failed" : ""}>
+              <span className="up-name">{u.name}</span>
+              {u.error ? (
+                <>
+                  <span className="error small">{u.error}</span>
+                  <button className="icon-btn" aria-label="Dismiss"
+                    onClick={() => setQueue((q) => q.filter((x) => x.key !== u.key))}><Icon name="x" size={16} /></button>
+                </>
+              ) : (
+                <>
+                  <div className="track"><div className="fill live" style={{ width: `${u.progress * 100}%` }} /></div>
+                  <span className="mono small muted">{Math.round(u.progress * 100)}%</span>
+                </>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+
+      {files.length > 0 && (
+        <ul className="files">
+          {files.map((f, i) => (
+            <li key={f.id} className="file glass" style={{ "--i": Math.min(i, 12) }}>
+              <a className="thumb" href={`${API}/files/${f.id}`} target="_blank" rel="noopener noreferrer">
+                {isImage(f.type) ? (
+                  <img src={`${API}/files/${f.id}`} alt={f.name} loading="lazy" />
+                ) : (
+                  <span className="ext">{ext(f.name)}</span>
+                )}
+              </a>
+              <div className="file-info">
+                <span className="file-name" title={f.name}>{f.name}</span>
+                <span className="muted small mono">{fmtSize(f.size)}</span>
+              </div>
+              {confirmId === f.id ? (
+                <div className="file-actions pop">
+                  <button className="danger small-btn" onClick={() => remove(f.id)}>Delete</button>
+                  <button className="small-btn" onClick={() => setConfirmId(null)}>Keep</button>
+                </div>
+              ) : (
+                <div className="file-actions">
+                  <a className="icon-btn" href={`${API}/files/${f.id}?download`} aria-label={`Download ${f.name}`}>
+                    <Icon name="down" size={16} />
+                  </a>
+                  <button className="icon-btn" aria-label={`Delete ${f.name}`} onClick={() => setConfirmId(f.id)}>
+                    <Icon name="trash" size={16} />
+                  </button>
+                </div>
+              )}
+            </li>
+          ))}
+        </ul>
+      )}
+    </section>
+  );
+}
diff --git a/apps/notes/frontend/src/index.css b/apps/notes/frontend/src/index.css
new file mode 100644
index 0000000..15a0220
--- /dev/null
+++ b/apps/notes/frontend/src/index.css
@@ -0,0 +1,177 @@
+/* =====================================================================
+   notes — aurora background + liquid glass (same recipe as landing)
+   Every colour lives in the :root block below. Edit it there only.
+   ===================================================================== */
+
+:root {
+  /* ---------- palette ---------- */
+  --bg: #05090b;
+  --text: #e8ecea;
+  --text-strong: #f4f6f5;
+  --text-soft: #b7c3c5;
+  --muted: #8ea3a7;
+
+  /* accent: the "rgb" versions let us write rgba(var(--accent-rgb), 0.3) */
+  --accent-rgb: 103, 232, 249;          /* cyan (#67e8f9) */
+  --accent-light-rgb: 165, 243, 252;    /* lighter cyan for highlights */
+  --accent: rgb(var(--accent-rgb));
+
+  --on-accent: #101a1c;                 /* text colour on accent buttons */
+  --accent-grad: linear-gradient(135deg, rgba(var(--accent-light-rgb), 0.95), rgba(var(--accent-rgb), 0.75));
+  --accent-grad-hover: linear-gradient(135deg, rgba(var(--accent-light-rgb), 1), rgba(var(--accent-rgb), 0.9));
+
+  --teal: #6fd6c4;
+  --amber: #f2a65a;
+
+  --danger-rgb: 224, 122, 107;
+  --danger: rgb(var(--danger-rgb));
+  --danger-solid: #c4493c;
+  --danger-solid-hover: #d6554a;
+  --on-danger: #fff;
+
+  --white-rgb: 255, 255, 255;
+  --black-rgb: 0, 0, 0;
+
+  /* aurora blobs (r, g, b) */
+  --aurora-1: var(--accent-rgb);
+  --aurora-2: 143, 168, 255;   /* blue */
+  --aurora-3: 181, 140, 240;   /* violet */
+  --aurora-4: 224, 122, 159;   /* pink */
+  --aurora-5: 111, 214, 196;   /* teal */
+  --noise-opacity: 0.09;       /* 0 = no grain, 0.15 = very grainy */
+
+  /* ---------- shapes ---------- */
+  --btn-radius: 20px;
+  --panel-radius: 22px;
+  --field-radius: 16px;
+
+  /* ---------- the liquid-glass recipe ---------- */
+  --glass-bg: linear-gradient(145deg, rgba(var(--white-rgb), 0.11), rgba(var(--white-rgb), 0.03));
+  --glass-bg-hover: linear-gradient(145deg, rgba(var(--white-rgb), 0.17), rgba(var(--white-rgb), 0.06));
+  --glass-border: 1px solid rgba(var(--white-rgb), 0.15);
