From f14d57ae94d45ba5a051ee57527885b55ee83f1f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 25 Oct 2026 15:57:14 +0800
Subject: [PATCH] transport: show arrival clock time (SGT) in target toasts

Bus toast shows the exact ETA from LTA ("ETA 3:59 pm"); train toast shows
an approximate one ("ETA ~4:01 pm") since the SMRT feed gives whole
minutes. Always formatted in Asia/Singapore time regardless of the
device's time zone. "next after" shortened to "then" to fit narrow phones.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XeNA851ypCRWj3cXpmL72E
---
 apps/transport/frontend/src/App.css          | 12 ++++++++++++
 apps/transport/frontend/src/TargetToasts.jsx | 15 ++++++++++++---
 apps/transport/frontend/src/lib.js           |  9 +++++++++
 3 files changed, 33 insertions(+), 3 deletions(-)

diff --git a/apps/transport/frontend/src/App.css b/apps/transport/frontend/src/App.css
index 68223a9..459cf4b 100644
--- a/apps/transport/frontend/src/App.css
+++ b/apps/transport/frontend/src/App.css
@@ -542,6 +542,18 @@ h1 {
   text-overflow: ellipsis;
 }
 
+.toast-arrives {
+  margin-top: 2px;
+  font-family: "IBM Plex Mono", monospace;
+  font-size: 0.74rem;
+  color: var(--text-soft);
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+.toast-arrives strong { color: var(--accent); font-weight: 500; }
+.toast-soon .toast-arrives strong { color: var(--amber); }
+
 .toast-time { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 1px; }
 .toast-big {
   font-family: "Space Grotesk", sans-serif;
diff --git a/apps/transport/frontend/src/TargetToasts.jsx b/apps/transport/frontend/src/TargetToasts.jsx
index 6e33433..6ae9ec8 100644
--- a/apps/transport/frontend/src/TargetToasts.jsx
+++ b/apps/transport/frontend/src/TargetToasts.jsx
@@ -1,5 +1,5 @@
 import { useEffect, useState } from "react";
-import { api, usePolling, useNow, countdown, serverNow } from "./lib.js";
+import { api, usePolling, useNow, countdown, serverNow, clockTime } from "./lib.js";
 import { BusIcon, TrainIcon, CloseIcon } from "./Icons.jsx";
 import { shortPlatform } from "./MrtView.jsx";
 
@@ -72,7 +72,7 @@ function BusToast({ target, onClose, onLabel }) {
     small = "Arriving now";
   } else {
     big = countdown(msLeft);
-    small = after ? `next after: ${Math.max(1, Math.floor((Date.parse(after.eta) - now) / 60000))} min` : "last estimate";
+    small = after ? `then ${Math.max(1, Math.floor((Date.parse(after.eta) - now) / 60000))} min` : "last estimate";
   }
 
   return (
@@ -80,6 +80,8 @@ function BusToast({ target, onClose, onLabel }) {
       icon={<BusIcon size={20} />}
       title={`Bus ${target.no}`}
       subtitle={target.stopName}
+      // LTA gives an exact timestamp, so this is the precise arrival time.
+      arrives={next ? clockTime(Date.parse(next.eta)) : null}
       big={big}
       small={small}
       urgency={urgency(msLeft)}
@@ -142,6 +144,8 @@ function TrainToast({ target, onClose, onLabel }) {
       icon={<TrainIcon size={20} />}
       title={dest ? `Train to ${dest}` : "Train"}
       subtitle={`${target.station} · Plat ${shortPlatform(target.platform)}`}
+      // Whole minutes only, so the clock time is approximate ("~").
+      arrives={msLeft === null ? null : `~${clockTime(now + msLeft)}`}
       big={big}
       small={small}
       urgency={urgency(msLeft)}
@@ -152,13 +156,18 @@ function TrainToast({ target, onClose, onLabel }) {
 
 const urgency = (ms) => (ms === null ? "idle" : ms <= 60_000 ? "now" : ms <= 3 * 60_000 ? "soon" : "later");
 
-function Toast({ icon, title, subtitle, big, small, urgency, onClose }) {
+function Toast({ icon, title, subtitle, arrives, big, small, urgency, onClose }) {
   return (
     <div className={`toast toast-${urgency}`}>
       <span className="toast-icon">{icon}</span>
       <span className="toast-text">
         <span className="toast-title">{title}</span>
         <span className="toast-sub">{subtitle}</span>
+        {arrives && (
+          <span className="toast-arrives">
+            ETA <strong>{arrives}</strong>
+          </span>
+        )}
       </span>
       <span className="toast-time">
         <span className="toast-big">{big}</span>
diff --git a/apps/transport/frontend/src/lib.js b/apps/transport/frontend/src/lib.js
index 7668da8..fb2f2f2 100644
--- a/apps/transport/frontend/src/lib.js
+++ b/apps/transport/frontend/src/lib.js
@@ -132,6 +132,15 @@ export function countdown(ms) {
   return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
 }
 
+// Clock time in Singapore, e.g. "3:59 pm". Always Singapore time, even if the
+// phone is set to another time zone (handy when travelling).
+const SG_TIME = new Intl.DateTimeFormat("en-SG", {
+  timeZone: "Asia/Singapore",
+  hour: "numeric",
+  minute: "2-digit",
+});
+export const clockTime = (ms) => (Number.isFinite(ms) ? SG_TIME.format(new Date(ms)) : null);
+
 // ---------------------------------------------------------------------------
 // MRT line colours (official LTA palette)
 // ---------------------------------------------------------------------------
