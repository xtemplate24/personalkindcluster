+  27%  { transform: translate3d(-9%, -3%, 0) rotate(-9deg)  scale(1.16); }
+  52%  { transform: translate3d(6%, -9%, 0)  rotate(3deg)   scale(0.95); }
+  79%  { transform: translate3d(8%, 5%, 0)   rotate(-5deg)  scale(1.1); }
