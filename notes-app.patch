+html::after {
+  background:
+    radial-gradient(55% 24% at 70% 25%, rgba(var(--aurora-3), 0.30), transparent 70%),
+    radial-gradient(38% 38% at 20% 75%, rgba(var(--aurora-4), 0.22), transparent 70%);
