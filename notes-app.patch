+body::before {
+  background:
+    radial-gradient(50% 22% at 55% 55%, rgba(var(--aurora-5), 0.26), transparent 70%),
+    radial-gradient(30% 30% at 85% 15%, rgba(var(--aurora-1), 0.20), transparent 70%);
