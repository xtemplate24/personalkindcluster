From 723b4fb47b37b1e67d671d510fc7787d184119d8 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 21:34:09 +0800
Subject: [PATCH] notes: proper back-to-xtemplate.cc link, fix All notes button
 layout

The copied .back rule from transport also matched the editor's
'All notes' button (button.back), stretching it to full width.
The home link now has its own .home-link class.
---
 apps/notes/frontend/src/App.css | 27 ++++++++++++++++++++-------
 apps/notes/frontend/src/App.jsx |  6 +++---
 2 files changed, 23 insertions(+), 10 deletions(-)

diff --git a/apps/notes/frontend/src/App.css b/apps/notes/frontend/src/App.css
index 6bf8ccb..9f6fdf0 100644
--- a/apps/notes/frontend/src/App.css
+++ b/apps/notes/frontend/src/App.css
@@ -32,19 +32,32 @@ p { margin: 0; }
   backdrop-filter: var(--glass-blur);
 }
 
-/* ---------- buttons: glass pills (same as app3) ---------- */
-.back {
-  width: 100%;
-  display: inline-block;
-  margin-bottom: 22px;
+/* ---------- "← xtemplate.cc" link back to landing (list screen only) ----------
+   Its own class on purpose: ".back" is the editor's "All notes" button. */
+.home-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  margin-bottom: 24px;
+  padding: 6px 14px 6px 10px;
   font-family: "IBM Plex Mono", monospace;
   font-size: 0.8rem;
   color: var(--muted);
   text-decoration: none;
-  transition: color 0.2s;
+  background: rgba(var(--white-rgb), 0.04);
+  border: 1px solid rgba(var(--white-rgb), 0.1);
+  border-radius: 999px;
+  transition: color 0.2s, border-color 0.2s, background 0.2s;
+}
+.home-link svg { transition: transform 0.2s; }
+.home-link:hover, .home-link:focus-visible {
+  color: var(--accent);
+  border-color: rgba(var(--accent-rgb), 0.4);
+  background: rgba(var(--accent-rgb), 0.08);
 }
-.back:hover, .back:focus-visible { color: var(--accent); }
+.home-link:hover svg { transform: translateX(-3px); }
 
+/* ---------- buttons: glass pills (same as app3) ---------- */
 button, input, textarea { font-family: inherit; }
 
 button, .icon-btn {
diff --git a/apps/notes/frontend/src/App.jsx b/apps/notes/frontend/src/App.jsx
index cb8f1c4..853a754 100644
--- a/apps/notes/frontend/src/App.jsx
+++ b/apps/notes/frontend/src/App.jsx
@@ -134,10 +134,10 @@ function NoteList({ usage, onOpen }) {
 
   return (
     <div className="screen">
+      <a className="home-link" href="https://xtemplate.cc">
+        <Icon name="back" size={14} /> xtemplate.cc
+      </a>
       <header className="top">
-        <a className="back" href="https://xtemplate.cc">
-            ← xtemplate.ccs
-        </a>
         <div>
           <h1>Notes</h1>
           <p className="muted small">Your notes and files, stored on the home lab.</p>
-- 
